# ==============================================================================
# ItemForge Docker deployment configuration.
#
# Copy this file to `.env` and run `./install.sh` -- the script will fill in
# every blank value below interactively (or auto-generate it). Do NOT hand-edit
# secrets here yourself and do NOT commit the real `.env` file to git.
# ==============================================================================

# --- Minecraft / Paper server -----------------------------------------------

# Passed straight to the itzg/minecraft-server VERSION env var. Never hardcode
# a specific version (e.g. "1.21.11") here -- admins running a different
# Minecraft version must be able to override this without editing compose
# files. "LATEST" lets itzg/minecraft-server resolve the newest Paper build.
MC_VERSION=LATEST

# Host port that Minecraft clients connect to. Published to the host.
MC_PORT=25565

# Mojang EULA acceptance (https://www.minecraft.net/en-us/eula). Must be the
# literal string "true". install.sh only sets this after you explicitly type
# "yes" to the EULA prompt -- never set this by hand without having read it.
EULA=

# --- Resource pack HTTP server (plugin-side, unauthenticated) ---------------
# Served directly to real Minecraft clients over the internet/LAN -- this is
# NOT the dashboard API, so this port IS published to the host.

RESOURCE_PACK_PORT=8080

# Public IP or domain that Minecraft clients will use to download the
# resource pack (e.g. "play.example.com" or a public IP). Leave blank to keep
# resource-pack hosting disabled -- the plugin refuses to start that HTTP
# server until this is a real, non-placeholder host (same fail-safe as its
# non-Docker config.yml).
RESOURCE_PACK_HOST=

# --- Dashboard <-> plugin API (internal Docker network only) ---------------
# The dashboard container talks to the plugin container by service name
# (http://paper-server:$DASHBOARD_API_PORT), never through localhost, and this
# port is NEVER published to the host. It must be different from
# RESOURCE_PACK_PORT and DASHBOARD_PORT.

DASHBOARD_API_PORT=8081

# Shared secret between the dashboard and the plugin's dashboard-api. Left
# blank here on purpose -- install.sh generates this with
# `openssl rand -hex 32` so it's never a weak, guessable value you typed in.
ITEMFORGE_API_TOKEN=

# --- Dashboard web UI ---------------------------------------------------------

# Host port for the dashboard web UI. Published to the host.
DASHBOARD_PORT=8090

DASHBOARD_ADMIN_USERNAME=admin

# BCrypt hash of the dashboard admin password, generated by install.sh. It
# uses `htpasswd` when present, otherwise it hashes inside a throwaway
# `httpd:2.4-alpine` container (Docker is required anyway), otherwise python3
# with the `bcrypt` module -- so no extra system package is ever needed. Left
# blank on purpose -- the plaintext password is never written to this file,
# only its hash. install.sh will refuse to start the stack if this is still
# blank (no guessable default is used).
DASHBOARD_ADMIN_PASSWORD_HASH=
